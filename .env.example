# Application
APP_NAME=recova-backend-v2
APP_ENV=local
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
DOCS_URL=https://docs.recova.app

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recova_db?sslmode=disable
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recova_db?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_SEC=300
DATABASE_SSL_MODE=disable

# Auth
JWT_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
GOOGLE_CLIENT_ID=replace-with-google-client-id
AUTH_COOKIE_NAME=recova_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# AI
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=replace-with-provider-key
AI_BASE_URL=
AI_TIMEOUT_MS=10000
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Security
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20
REQUEST_BODY_LIMIT=1mb

# Observability
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
HEALTH_CHECK_TIMEOUT_MS=2000
