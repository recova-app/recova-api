{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "scalar": "2.0.0",
  "info": {
    "title": "Recova Backend API Docs",
    "description": "Service documentation and API reference for Recova Backend."
  },
  "navigation": {
    "routes": {
      "/": {
        "title": "Overview",
        "type": "page",
        "filepath": "docs/overview.md"
      },
      "/api": {
        "title": "API Reference",
        "type": "openapi",
        "filepath": "docs/generated/openapi.yaml"
      },
      "/architecture": {
        "title": "Architecture",
        "type": "page",
        "filepath": "docs/architecture.md"
      },
      "/environment": {
        "title": "Environment",
        "type": "page",
        "filepath": "docs/environment.md"
      },
      "/project-structure": {
        "title": "Project Structure",
        "type": "page",
        "filepath": "docs/project-structure.md"
      },
      "/database": {
        "title": "Database",
        "type": "page",
        "filepath": "docs/database.md"
      },
      "/api-guide": {
        "title": "API Guide",
        "type": "page",
        "filepath": "docs/api-reference.md"
      },
      "/modules": {
        "title": "Modules",
        "type": "page",
        "filepath": "docs/modules/index.md"
      },
      "/operations": {
        "title": "Operations",
        "type": "group",
        "children": {
          "/operations/testing": {
            "title": "Testing",
            "type": "page",
            "filepath": "docs/operations/testing.md"
          },
          "/operations/security": {
            "title": "Security",
            "type": "page",
            "filepath": "docs/operations/security.md"
          },
          "/operations/documentation-sync": {
            "title": "Documentation Sync",
            "type": "page",
            "filepath": "docs/operations/documentation-sync.md"
          },
          "/operations/api-docs-generation": {
            "title": "API Docs Generation",
            "type": "page",
            "filepath": "docs/operations/api-docs-generation.md"
          }
        }
      }
    }
  },
  "siteConfig": {
    "theme": "default",
    "layout": {
      "toc": true,
      "header": true,
      "search": {
        "enabled": true,
        "position": "header"
      }
    }
  }
}
