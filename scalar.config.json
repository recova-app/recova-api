{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "info": {
    "title": "Recova Backend API Docs",
    "description": "Service documentation and API reference for Recova Backend."
  },
  "navigation": {
    "routes": {
      "/": {
        "title": "Overview",
        "type": "page",
        "filepath": "docs/OVERVIEW.md"
      },
      "/api": {
        "title": "API Reference",
        "type": "openapi",
        "filepath": "docs/generated/openapi.yaml"
      },
      "/api-guide": {
        "title": "API Guide",
        "type": "page",
        "filepath": "docs/API.md"
      },
      "/architecture": {
        "title": "Architecture",
        "type": "page",
        "filepath": "docs/ARCHITECTURE.md"
      },
      "/database": {
        "title": "Database",
        "type": "page",
        "filepath": "docs/DATABASE.md"
      },
      "/environment": {
        "title": "Environment",
        "type": "page",
        "filepath": "docs/ENVIRONMENT.md"
      },
      "/modules": {
        "title": "Modules",
        "type": "page",
        "filepath": "docs/MODULES.md"
      },
      "/operations": {
        "title": "Operations",
        "type": "page",
        "filepath": "docs/OPERATIONS.md"
      },
      "/decisions": {
        "title": "Architecture Decisions",
        "type": "page",
        "filepath": "docs/ADR.md"
      }
    }
  },
  "scalar": "2.0.0",
  "siteConfig": {
    "layout": {
      "header": true,
      "search": {
        "enabled": true,
        "position": "header"
      },
      "toc": true
    },
    "theme": "default"
  }
}
